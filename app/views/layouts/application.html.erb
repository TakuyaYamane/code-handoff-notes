<body>
  <header class="site-header">
    <div class="site-header-inner">
      <h1 class="site-title">
        <%= link_to "CodeHandoff Notes", root_path %>
      </h1>
      <p class="site-description">
        ソフトウェアの引き継ぎ情報を整理し、Markdownドキュメントとして生成するRailsアプリ
      </p>
    </div>
  </header>

  <main class="container">
    <% if notice.present? %>
      <div class="notice"><%= notice %></div>
    <% end %>

    <% if alert.present? %>
      <div class="alert"><%= alert %></div>
    <% end %>

    <%= yield %>
  </main>
</body>