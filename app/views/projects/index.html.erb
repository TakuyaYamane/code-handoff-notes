<div class="page-header">
  <div>
    <h2 class="page-title">プロジェクト一覧</h2>
    <p class="page-lead">
      ソフトウェアの引き継ぎ情報を整理し、Markdownドキュメントとして残します。
    </p>
  </div>

  <%= link_to "新しいプロジェクトを作成", new_project_path, class: "button" %>
</div>

<% if @projects.any? %>
  <div class="card-grid">
    <% @projects.each do |project| %>
      <div class="card">
        <h3 class="card-title">
          <%= link_to project.name, project_path(project) %>
        </h3>

        <p class="card-description">
          <%= project.description.presence || "説明はまだありません。" %>
        </p>

        <div class="actions">
          <%= link_to "詳細を見る", project_path(project), class: "button button-secondary" %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">
    <p>まだプロジェクトがありません。</p>
    <%= link_to "最初のプロジェクトを作成する", new_project_path, class: "button" %>
  </div>
<% end %>