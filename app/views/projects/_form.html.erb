<% if project.errors.any? %>
  <div class="error-box">
    <h3>入力内容を確認してください</h3>

    <ul>
      <% project.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: project do |form| %>
  <div class="form-group">
    <%= form.label :name, "プロジェクト名" %>
    <%= form.text_field :name, placeholder: "例：学習記録カレンダーアプリ" %>
    <p class="help-text">引き継ぎ対象となるアプリやサービスの名前です。</p>
  </div>

  <div class="form-group">
    <%= form.label :description, "説明" %>
    <%= form.text_area :description, rows: 5, placeholder: "このプロジェクトの目的や概要を書いてください。" %>
  </div>

  <div class="actions">
    <%= form.submit "保存する" %>
    <%= link_to "戻る", projects_path, class: "button button-secondary" %>
  </div>
<% end %>