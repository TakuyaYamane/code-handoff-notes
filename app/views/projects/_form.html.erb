<% if project.errors.any? %>
  <div style="color: red;">
    <h3><%= pluralize(project.errors.count, "error") %> prohibited this project from being saved:</h3>

    <ul>
      <% project.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: project do |form| %>
  <div>
    <%= form.label :name %><br>
    <%= form.text_field :name, placeholder: "Example: Learning Calendar App" %>
  </div>

  <div style="margin-top: 16px;">
    <%= form.label :description %><br>
    <%= form.text_area :description, rows: 5, placeholder: "What is this project for?" %>
  </div>

  <div style="margin-top: 16px;">
    <%= form.submit %>
  </div>
<% end %>