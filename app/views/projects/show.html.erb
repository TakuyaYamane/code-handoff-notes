<div class="page-header">
  <div>
    <h2 class="page-title"><%= @project.name %></h2>
    <p class="page-lead">
      <%= @project.description.presence || "説明はまだありません。" %>
    </p>
  </div>

  <div class="actions">
    <%= link_to "リポジトリを追加", new_project_repository_path(@project), class: "button" %>
  </div>
</div>

<div class="card">
  <h3 class="card-title">プロジェクト情報</h3>

  <ul class="meta-list">
    <li><strong>プロジェクト名：</strong><%= @project.name %></li>
    <li><strong>説明：</strong><%= @project.description.presence || "説明はまだありません。" %></li>
  </ul>

  <div class="actions">
    <%= link_to "編集する", edit_project_path(@project), class: "button button-secondary" %>
    <%= link_to "削除する", project_path(@project), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "button button-danger" %>
    <%= link_to "一覧に戻る", projects_path, class: "button button-secondary" %>
  </div>
</div>

<h3>登録済みリポジトリ</h3>

<% if @repositories.any? %>
  <% @repositories.each do |repository| %>
    <div class="card">
      <h4 class="card-title">
        <%= link_to repository.name, repository_path(repository) %>
      </h4>

      <p>
        <strong>GitHub URL：</strong>
        <%= link_to repository.url, repository.url, target: "_blank", rel: "noopener" %>
      </p>

      <p class="card-description">
        <%= repository.description.presence || "説明はまだありません。" %>
      </p>

      <div class="actions">
        <%= link_to "詳細を見る", repository_path(repository), class: "button button-secondary" %>
      </div>
    </div>
  <% end %>
<% else %>
  <div class="empty-state">
    <p>まだリポジトリが登録されていません。</p>
    <%= link_to "リポジトリを追加する", new_project_repository_path(@project), class: "button" %>
  </div>
<% end %>