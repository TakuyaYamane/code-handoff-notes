<% if handoff_document.errors.any? %>
  <div style="color: red;">
    <h3><%= pluralize(handoff_document.errors.count, "error") %> prohibited this document from being saved:</h3>

    <ul>
      <% handoff_document.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [repository, handoff_document] do |form| %>
  <div>
    <%= form.label :overview, "System Overview" %><br>
    <%= form.text_area :overview, rows: 6, placeholder: "What does this system do?" %>
  </div>

  <div style="margin-top: 16px;">
    <%= form.label :features, "Main Features" %><br>
    <%= form.text_area :features, rows: 6, placeholder: "- User registration\n- Project management\n- Markdown export" %>
  </div>

  <div style="margin-top: 16px;">
    <%= form.label :database_notes, "Database Notes" %><br>
    <%= form.text_area :database_notes, rows: 6, placeholder: "Main tables, relationships, important constraints..." %>
  </div>

  <div style="margin-top: 16px;">
    <%= form.label :environment_notes, "Environment Variables" %><br>
    <%= form.text_area :environment_notes, rows: 5, placeholder: "DATABASE_URL, AWS_ACCESS_KEY_ID..." %>
  </div>

  <div style="margin-top: 16px;">
    <%= form.label :setup_notes, "Setup Notes" %><br>
    <%= form.text_area :setup_notes, rows: 6, placeholder: "How to set up this app locally..." %>
  </div>

  <div style="margin-top: 16px;">
    <%= form.label :operation_notes, "Operation Notes" %><br>
    <%= form.text_area :operation_notes, rows: 6, placeholder: "How to deploy, monitor, and operate this app..." %>
  </div>

  <div style="margin-top: 16px;">
    <%= form.label :risks, "Risks / Handoff Warnings" %><br>
    <%= form.text_area :risks, rows: 6, placeholder: "Known issues, fragile parts, future refactoring points..." %>
  </div>

  <div style="margin-top: 16px;">
    <%= form.submit %>
  </div>
<% end %>