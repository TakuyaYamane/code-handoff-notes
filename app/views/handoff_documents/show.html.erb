<div class="page-header">
  <div>
    <h2 class="page-title">引き継ぎドキュメント</h2>
    <p class="page-lead">
      <%= @repository.name %> の引き継ぎ情報をMarkdown形式で表示しています。
    </p>
  </div>
</div>

<div class="card">
  <h3 class="card-title">操作</h3>

  <div class="actions">
    <%= link_to "編集する", edit_repository_handoff_document_path(@repository), class: "button" %>
    <%= link_to "リポジトリに戻る", repository_path(@repository), class: "button button-secondary" %>
  </div>
</div>

<pre class="markdown-preview"><%= @handoff_document.generated_markdown %></pre>