<% if repository.errors.any? %>
  <div style="color: red;">
    <h3><%= pluralize(repository.errors.count, "error") %> prohibited this repository from being saved:</h3>

    <ul>
      <% repository.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: repository, url: url do |form| %>
  <div>
    <%= form.label :name %><br>
    <%= form.text_field :name, placeholder: "Example: code-handoff-notes" %>
  </div>

  <div style="margin-top: 16px;">
    <%= form.label :url %><br>
    <%= form.text_field :url, placeholder: "https://github.com/username/repository" %>
  </div>

  <div style="margin-top: 16px;">
    <%= form.label :description %><br>
    <%= form.text_area :description, rows: 5, placeholder: "What does this repository do?" %>
  </div>

  <div style="margin-top: 16px;">
    <%= form.submit %>
  </div>
<% end %>