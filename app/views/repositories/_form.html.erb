<% if repository.errors.any? %>
  <div class="error-box">
    <h3>入力内容を確認してください</h3>

    <ul>
      <% repository.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: repository, url: url do |form| %>
  <div class="form-group">
    <%= form.label :name, "リポジトリ名" %>
    <%= form.text_field :name, placeholder: "例：code-handoff-notes" %>
  </div>

  <div class="form-group">
    <%= form.label :url, "GitHub URL" %>
    <%= form.text_field :url, placeholder: "https://github.com/username/repository" %>
    <p class="help-text">GitHubリポジトリのURLを入力してください。</p>
  </div>

  <div class="form-group">
    <%= form.label :description, "説明" %>
    <%= form.text_area :description, rows: 5, placeholder: "このリポジトリが何をするものかを書いてください。" %>
  </div>

  <div class="actions">
    <%= form.submit "保存する" %>
    <%= link_to "戻る", projects_path, class: "button button-secondary" %>
  </div>
<% end %>